# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=refund_db
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/refund_db?schema=public"

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Admin Authentication Secret (set a private value for local use)
ADMIN_API_KEY="replace-with-a-local-secret"

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
